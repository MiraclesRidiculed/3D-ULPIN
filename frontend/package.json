{
  "name": "vcad-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "copy-cesium": "node scripts/copy-cesium.mjs",
    "test": "npm run test:logic && npm run test:workflow",
    "test:logic": "node --test --experimental-strip-types scripts/workflow-logic.test.mjs scripts/compare-logic.test.mjs",
    "test:workflow": "node --test scripts/workflow.test.mjs",
    "test:pipeline": "node scripts/pipeline.test.mjs",
    "postinstall": "npm run copy-cesium"
  },
  "dependencies": {
    "@cesium/engine": "^26.3.0",
    "@cesium/widgets": "^16.2.0",
    "cesium": "^1.145.0",
    "lucide-react": "^0.468.0",
    "next": "^14.2.28",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "caniuse-lite": "^1.0.30001810",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
  }
}
